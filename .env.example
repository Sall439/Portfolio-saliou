# Variables d'environnement EmailJS (formulaire de contact)
# Copiez ce fichier en `.env.local` et remplacez les valeurs par les vôtres.
# Retrievez-les sur https://dashboard.emailjs.com -> Account -> General / Email Templates

NEXT_PUBLIC_SERVICE_ID=
NEXT_PUBLIC_TEMPLATE_ID=
NEXT_PUBLIC_PUBLIC_KEY=

# Le template EmailJS doit attendre ces champs :
#   {{name}}    -> input[name="name"]
#   {{email}}   -> input[name="email"]
#   {{message}} -> textarea[name="message"]
